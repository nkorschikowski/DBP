        <mapping class="com.uni.entities.Filiale"/>
        <mapping class="com.uni.entities.Kategorie"/>
        <mapping class="com.uni.entities.Kauf"/>
        <mapping class="com.uni.entities.KaufProdukt"/>
        <mapping class="com.uni.entities.KuenstlerCD"/>
        <mapping class="com.uni.entities.Kunde"/>
        <mapping class="com.uni.entities.MusikCD"/>
        <mapping class="com.uni.entities.Person"/>
        <mapping class="com.uni.entities.Produkt"/>
        <mapping class="com.uni.entities.ProduktKategorie"/>
        <mapping class="com.uni.entities.Rezension"/>
        <mapping class="com.uni.entities.Titel"/>
        
    </session-factory>
</hibernate-configuration>
